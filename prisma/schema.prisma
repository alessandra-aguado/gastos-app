// Esquema completo según el modelo de datos acordado.
// NOTA: en este sandbox no se pudo correr `prisma generate` (el binario del
// engine se descarga de binaries.prisma.sh, bloqueado por la red del sandbox).
// En tu máquina esto no pasará: solo corre `npm install && npx prisma generate`.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  // Para probar local sin nada instalado, puedes cambiar esto a:
  // provider = "sqlite"
  // url      = "file:./dev.db"
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  icon        String?  // nombre del icono lucide, ej. "utensils"
  color       String?  // hex, ej. "#D8E8D4"
  description String? // se inyecta al prompt de clasificación de la IA
  parentId    String?
  parent      Category?  @relation("Subcategories", fields: [parentId], references: [id])
  children    Category[] @relation("Subcategories")

  transactions     Transaction[]
  transactionItems TransactionItem[]
  budgets          Budget[]
  fixedExpenses    FixedExpense[]
  wishlistItems    WishlistItem[]
  plannedExpenses  PlannedExpense[]
  simulationItems  SimulationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentMethod {
  id            String   @id @default(cuid())
  name          String
  type          String // debito | credito | billetera_digital | efectivo
  bankOrIssuer  String?
  closingDay    Int?    // fecha de corte, solo credito
  billingDay    Int?    // fecha de facturacion, solo credito
  transactions  Transaction[]
  fixedExpenses FixedExpense[]
  account       Account?
  debt          Debt?
  plannedExpenses PlannedExpense[]
  simulationItems SimulationItem[]
  createdAt     DateTime @default(now())
}

model Transaction {
  id            String   @id @default(cuid())
  amount        Float
  date          DateTime
  merchant      String?
  source        String // foto | voz | texto | manual | email
  rawInput      String? // texto original o referencia a la imagen
  aiConfidence  Int? // 0-100
  status        String   @default("confirmado") // confirmado | pendiente_revision
  notes         String?

  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id])
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  fixedExpenseId  String?
  fixedExpense    FixedExpense?  @relation(fields: [fixedExpenseId], references: [id])

  items TransactionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Línea de producto dentro de una boleta (supermercado, etc).
// Alimenta el comparador de precios por producto + tienda.
model TransactionItem {
  id            String   @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productName   String
  quantity      Float    @default(1)
  unitPrice     Float
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  createdAt     DateTime @default(now())
}

model Budget {
  id          String @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  month       String // formato "2026-08"
  amountLimit Float
  createdAt   DateTime @default(now())

  @@unique([categoryId, month])
}

model FixedExpense {
  id              String   @id @default(cuid())
  name            String
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  amount          Float
  frequency       String // mensual | semanal | anual
  nextDueDate     DateTime?
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  dueMode         String   @default("unica") // unica | rango
  dueDay          Int?     // día del mes si dueMode = unica
  rangeStart      Int?     // día de emisión si dueMode = rango
  rangeEnd        Int?     // día límite de pago si dueMode = rango
  reminderDays    Int      @default(3)
  syncCalendar    Boolean  @default(false)
  lastPaidMonth   String?  // "2026-08", último mes marcado como pagado
  transactions    Transaction[]
  createdAt       DateTime @default(now())
}

model SavingsGoal {
  id                String   @id @default(cuid())
  name              String // propósito: "curso de inglés", "depa"
  targetAmount      Float
  currentAmount     Float    @default(0)
  targetDate        DateTime?
  status            String   @default("activa") // activa | completada
  method            String?  // efectivo | cuotas
  isEmergencyFund   Boolean  @default(false)
  isPercentageGoal  Boolean  @default(false)
  totalValue        Float?   // valor total del bien, si la meta es "% del valor"
  percentage        Float?   // % del valor total que representa la meta
  motivo            String?  // para qué ahorras / con qué visión
  timeframeMonths   Int?
  originWishlistId  String?  @unique
  originWishlist    WishlistItem? @relation(fields: [originWishlistId], references: [id])
  contributions     SavingsContribution[]
  createdAt         DateTime @default(now())
}

model SavingsContribution {
  id            String      @id @default(cuid())
  savingsGoalId String
  savingsGoal   SavingsGoal @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade)
  amount        Float
  date          DateTime
  createdAt     DateTime    @default(now())
}

model Investment {
  id                String   @id @default(cuid())
  platform          String // Trii, bolsa de valores, etc.
  instrumentType    String // acciones, fondo, etc.
  kind              String   @default("variable") // variable | fija
  amountContributed Float
  date              DateTime
  currentValue      Float?
  tea               Float?   // tasa efectiva anual, solo renta fija
  termMonths        Int?     // plazo en meses, solo renta fija
  maturityDate      DateTime? // fecha de vencimiento, solo renta fija
  createdAt         DateTime @default(now())
}

model Debt {
  id              String   @id @default(cuid())
  type            String // tarjeta_credito | prestamo_personal
  counterpartName String? // nombre del amigo o del banco
  direction       String? // yo_debo | me_deben (solo prestamo_personal)
  principalAmount Float
  balance         Float
  creditLimit     Float?  // solo tarjeta_credito
  minPayment      Float?  // cuota mínima mensual, solo tarjeta_credito
  dueDay          Int?    // día del mes en que vence
  interestRate    Float?  // tasa de interes, solo prestamo_personal
  startDate       DateTime? // desde cuando existe la deuda
  status          String   @default("activa") // activa | pagada
  dueDate         DateTime?
  alertaPorcentaje Int?    // umbral de alerta de uso (%) personalizado para esta tarjeta; si es null se usa Settings.alertaTarjetaDefault
  paymentMethodId String?        @unique // vincula esta deuda a la tarjeta (PaymentMethod tipo credito) para sincronizar gastos automaticamente
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  payments        DebtPayment[]
  simulationItems SimulationItem[]
  paymentPlans    DebtPaymentPlan[]
  createdAt       DateTime @default(now())
}

// Plan de pago futuro y real (no hipotético) para una deuda de tarjeta: "pienso pagar
// esto en tal mes". Distinto de DebtPayment (que registra un pago ya hecho). Alimenta
// Presupuesto > Proyeccion y el Simulador para no asumir siempre el pago minimo.
model DebtPaymentPlan {
  id        String   @id @default(cuid())
  debtId    String
  debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  month     String   // "2026-08"
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([debtId, month])
}

model DebtPayment {
  id     String   @id @default(cuid())
  debtId String
  debt   Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount Float
  date   DateTime
  note   String?
}

model WishlistItem {
  id             String   @id @default(cuid())
  name           String
  estimatedPrice Float
  link           String?
  notes          String?
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  isNecessary    Boolean  @default(false)
  status         String   @default("pendiente") // pendiente | comprado | convertido_a_meta
  savingsGoal    SavingsGoal?
  createdAt      DateTime @default(now())
}

model Account {
  id              String    @id @default(cuid())
  name            String // "Cuenta corriente", "Guardadito"
  bank            String // BCP, Interbank, BBVA...
  type            String // corriente | ahorro | billetera | puntos | custodia
  balance         Float     @default(0)
  lastCheckIn     DateTime?
  paymentMethodId String?        @unique
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  checkIns        AccountCheckIn[]
  movements       FundMovement[]
  createdAt       DateTime  @default(now())
}

// Movimientos de una cuenta tipo "custodia" (plata de terceros que administras).
// Cada movimiento ajusta el balance de la cuenta y vive separado de Transaction,
// para no contaminar Gastos/Presupuesto con dinero que no es tuyo.
model FundMovement {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        String   // ingreso | gasto
  amount      Float
  date        DateTime
  description String?
  imageUrl    String?  // foto del comprobante (Vercel Blob), evidencia opcional
  createdAt   DateTime @default(now())
}

// Snapshot del saldo confirmado por mes, para reconciliacion mensual.
model AccountCheckIn {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  month     String   // "2026-08"
  balance   Float
  date      DateTime @default(now())

  @@unique([accountId, month])
}

// Ítem 100% hipotético para el Simulador de varios meses: nunca se convierte en un
// Gasto, Deuda ni Fijo real. Vive aparte para poder "jugar" con escenarios futuros
// (ingresos extra, gastos que evalúas, pagos extra a una tarjeta) sin tocar tus datos.
model SimulationItem {
  id              String   @id @default(cuid())
  month           String   // "2026-09"
  type            String   // ingreso | gasto | pago_deuda
  description     String
  amount          Float
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id])
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  debtId          String?
  debt            Debt?          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

// Gasto (o préstamo dado) que aún no sucede pero que Ale quiere proyectar
// contra el saldo de un medio de pago, antes de que sea un gasto o deuda real.
model PlannedExpense {
  id              String   @id @default(cuid())
  description     String
  amount          Float
  month           String   // "2026-08" (mes en que se planifica/registra, no necesariamente el de facturacion)
  date            DateTime? // fecha en la que piensa hacer la compra; usada para calcular el ciclo de facturacion si es con tarjeta
  kind            String   @default("gasto") // gasto | prestamo
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id])
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  counterpartName String?  // solo si kind = prestamo
  status          String   @default("pendiente") // pendiente | realizado | descartado
  createdAt       DateTime @default(now())
}

model Income {
  id        String   @id @default(cuid())
  amount    Float
  date      DateTime
  type      String   // fijo | variable
  source    String?  // "Sueldo", "Cobro de deuda", "Regalo"...
  notes     String?
  createdAt DateTime @default(now())
}

model Settings {
  id            String  @id @default("singleton")
  monthlyIncome Float?
  pctFijos      Float   @default(60) // % del ingreso destinado a fijos (regla de reparto, personalizable)
  pctVariable   Float   @default(30) // % del ingreso destinado a gastos variables
  pctAhorro     Float   @default(10) // % del ingreso destinado a ahorro
  decimales     Int     @default(0) // cantidad de decimales al mostrar montos en soles (0-3, personalizable)
  alertaTarjetaDefault Int @default(30) // % de uso de tarjeta al que se muestra alerta, por defecto (personalizable por tarjeta en Debt.alertaPorcentaje)
  tarjetaPagoDefault String @default("minimo") // "minimo" | "total" — que asumir en Proyeccion/Simulador cuando NO hay un DebtPaymentPlan explicito para el mes
  saldoAnteriorSimulador Float @default(0) // saldo que sobro antes del primer mes que muestra el Simulador; lo ingresas tu a mano, se usa solo en el primer mes proyectado
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SavingsPlan {
  id              String   @id @default(cuid())
  month           String   @unique // "2026-08"
  totalAmount     Float
  colchonAmount   Float    @default(0)
  inversionAmount Float    @default(0)
  metasAmount     Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  entity    String   // "Meta" | "Cuenta" | "Deuda" | "Fijo" | "Deseo" | "Inversion" | "Ingreso" | "Presupuesto" | "Ahorro" | "Categoria" | "Medio de pago"
  action    String   // crear | editar | eliminar
  label     String
  snapshot  Json?    // copia de los datos del registro eliminado, para poder restaurarlo (por ahora solo Gasto)
  restored  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MonthlySnapshot {
  id        String   @id @default(cuid())
  month     String   @unique // "2026-08"
  ahorro    Float    @default(0) // suma de metas activas (SavingsGoal.currentAmount)
  inversion Float    @default(0) // suma de Investment.currentValue (o amountContributed)
  deuda     Float    @default(0) // suma de Debt.balance activas
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model EmailAccount {
  id              String @id @default(cuid())
  provider        String // gmail
  email           String
  oauthTokens     String? // encriptado en producción
  bankSearchQuery String?
  createdAt       DateTime @default(now())
}
